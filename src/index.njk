                    AmirReza Azari
                </h1>

                <p class="hero-description text-lg md:text-xl leading-8 mb-6">
                    Computer Engineering graduate from Sharif University of Technology
                </p>

                <div class="relative inline-flex items-center gap-3">
                    <a href="#"
                    onclick="event.preventDefault(); const msg = document.getElementById('cv-message'); msg.classList.remove('opacity-0'); clearTimeout(window.cvMessageTimer); window.cvMessageTimer = setTimeout(() => msg.classList.add('opacity-0'), 2000);"
