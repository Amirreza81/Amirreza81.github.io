    <!-- Tab Navigation -->
    <div class="flex flex-wrap justify-center mb-8 border-b border-gray-200/60 dark:border-[#2A2926]">
        {% for tab in collections.tabs %}
        <button 
            class="tab-button px-6 py-3 text-sm font-medium {% if tab.slug == 'about-me' %}border-primary-600 text-primary-600 dark:border-primary-400 dark:text-primary-400{% else %}text-gray-500 dark:text-gray-400 border-transparent{% endif %} hover:text-gray-700 dark:hover:text-gray-200 border-b-2 hover:border-gray-300 dark:hover:border-gray-600 transition-colors"
            data-tab="{{ tab.slug }}"
            {% if tab.slug == 'about-me' %}data-active="true"{% endif %}
        >
            {{ tab.name }}
        </button>
        {% endfor %}
    </div>

    <!-- Tab Content -->
    {% for tab in collections.tabs %}
    <div 
        class="tab-content {% if tab.slug != 'about-me' %}hidden{% endif %}"
        id="tab-{{ tab.slug }}"
    >
        <div class="mb-10">
            <h2 class="tab-heading text-3xl font-bold mb-4">{{ tab.name }}</h2>
        </div>

        {% if tab.slug == 'about-me' %}
        {% include "about-me-tab.njk" %}
        {% elif tab.slug == 'blog' %}
        {% include "blog-tab.njk" %}
        {% elif tab.slug == 'news' %}
        {% include "news-tab.njk" %}
        {% elif tab.items.length > 0 %}
        <div class="space-y-6">
            {% for item in tab.items %}
            <div class="portfolio-card bg-white dark:bg-[#1C2541] rounded-lg shadow-md">
                {% set showDetails = true %}
                {% if item.showDetails is defined and item.showDetails == false %}
                    {% set showDetails = false %}
                {% elif item.content and item.content.trim().length < 100 %}
                    {% set showDetails = false %}
                {% endif %}
                
                {% if showDetails %}
                <a href="/{{ tab.slug }}/{{ item.slug }}/"
                class="block no-underline hover:no-underline">
                {% endif %}
                    <div class="flex items-stretch portfolio-card-inner">
                        {% if item.image and item.image != "" and item.image != "placeholder.jpg" and item.image != "README.md" %}
                        <div class="flex items-center">
                            <div class="card-image-wrap w-28 md:w-32 h-full flex items-center justify-center rounded-l-xl">
                                <img 
                                    src="/content/{{ item.folder }}/{{ item.name }}/images/{{ item.image }}"
                                    alt="{{ item.title }}"
                                    class="w-16 h-16 md:w-20 md:h-20 object-contain"
                                    loading="lazy"
                                    onerror="this.parentElement.style.display='none'"
                                >
                            </div>
                        </div>
                        {% endif %}
                        
                        <div class="px-6 py-5 flex-1 flex flex-col justify-between">
                            <div class="flex items-start justify-between">
                                <div class="flex-1">
                                    <h3 class="card-title text-xl font-semibold mb-2">
                                        {{ item.title }}
                                    </h3>
                                    {% if item.badge %}
                                    <span class="px-2 py-0.5 text-xs font-semibold rounded-full
                                                {% if item.badge == "M.Sc." %}
                                                bg-yellow-100 text-yellow-800
                                                dark:bg-yellow-500/20 dark:text-yellow-300
                                                {% else %}
                                                bg-blue-100 text-blue-700
                                                dark:bg-blue-900/50 dark:text-blue-300
                                                {% endif %}">
                                        {{ item.badge }}
                                    </span>
                                    {% endif %}
                                    {% if item.organization %}
                                    <p class="card-organization text-sm font-medium mb-2">
                                        {{ item.organization }}
                                    </p>
                                    {% endif %}
                                    {% if item.professor %}
                                    <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">
                                        {{ item.professor }}
                                    </p>
                                    {% endif %}
                                    {% if item.description %}
                                    <p class="text-gray-700 dark:text-gray-300 mb-4">
                                        {{ item.description }}
                                    </p>
                                    {% endif %}
                                </div>
                                
                                <div class="ml-4 text-right">
                                    {% if item.start or item.end %}
                                    <div class="card-date text-sm">
                                        <div>{{ item.start }}</div>
                                        {% if item.end %}
                                        <div>{{ item.end }}</div>
                                        {% endif %}
                                        {% if item.showDuration %}
                                        <div class="text-xs text-blue-600 dark:text-blue-400 font-medium mt-1">
                                            {{ item.start | calculateDuration(item.end) }}
                                        </div>
                                        {% endif %}
                                    </div>
                                    {% endif %}
                                </div>
                            </div>
                            
                            <div class="flex items-center justify-between">
                                {% if showDetails %}
                                <div class="read-more flex items-center">
                                    <span class="text-sm font-medium">Read More</span>
                                    <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                    </svg>
                                </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% if showDetails %}
                </a>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% else %}
        <div class="text-center py-12">
            <div class="text-gray-500 dark:text-gray-400">
                <svg class="w-12 h-12 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                <p class="text-lg">No items found in {{ tab.name }}</p>
                <p class="text-sm mt-2">Add content by creating folders in /content/{{ tab.name }}/</p>
            </div>
        </div>
        {% endif %}
    </div>
    {% endfor %}
</div>
