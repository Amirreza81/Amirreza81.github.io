---
pagination:
  data: collections.allItems
  size: 1
  alias: item
permalink: /{{ item.tabSlug }}/{{ item.slug }}/
layout: layout.njk
---

{% if item.tabSlug == "blog" %}
<div id="reading-progress"
     class="fixed top-0 left-0 z-[100] h-1 bg-amber-500"
     style="width: 0%;">
</div>
{% endif %}

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb -->
    <nav class="mb-8">
        <ol class="flex items-center space-x-2 text-sm text-gray-500 dark:text-gray-400">
            <li><a href="/" class="hover:text-gray-700 dark:hover:text-gray-200">Home</a></li>
            <li class="before:content-['/'] before:mx-2">
                <a href="/#{{ item.tabSlug }}" class="hover:text-gray-700 dark:hover:text-gray-200">{{ item.tab }}</a>
            </li>
            <li class="before:content-['/'] before:mx-2 text-gray-900 dark:text-white">{{ item.title }}</li>
        </ol>
    </nav>

    <!-- Item Header -->
    <header class="mb-8 item-header">
        <div class="flex items-center justify-between mb-4">
            <h1 class="item-title text-4xl font-bold text-gray-900 dark:text-white">
                {{ item.title }}
            </h1>
            <div class="flex flex-col items-end space-y-1 text-sm text-gray-500 dark:text-gray-400">
                <div class="flex items-center space-x-2">
                    <span>{{ item.start }}</span>
                    {% if item.end %}
                    <span>–</span>
                    <span>{{ item.end }}</span>
                    {% endif %}
                </div>
                {% if item.showDuration %}
                <div class="text-xs text-blue-600 dark:text-blue-400 font-medium">
                    {{ item.start | calculateDuration(item.end) }}
                </div>
                {% endif %}
            </div>
        </div>
        
        {% if item.organization %}
        <p class="text-lg font-medium text-primary-600 dark:text-primary-400 mb-4">{{ item.organization }}</p>
        {% endif %}
        
        {% if item.description %}
            <p dir="ltr" class="text-xl item-header-description mb-6 text-left">
                {{ item.description }}
            </p>
        {% endif %}

        {% if item.tabSlug == "blog" %}
        <div class="flex items-center gap-2 mb-8" dir="ltr">

            <span class="text-xs font-medium text-gray-500 dark:text-gray-400 mr-1">
                Share
            </span>

            <!-- LinkedIn -->
            <button type="button"
                    data-share="linkedin"
                    aria-label="Share on LinkedIn"
                    title="Share on LinkedIn"
                    class="w-9 h-9 flex items-center justify-center rounded-full
                        border border-gray-200 dark:border-gray-700
                        text-gray-500 dark:text-gray-400
                        hover:text-amber-500 dark:hover:text-amber-400
                        hover:border-amber-400 dark:hover:border-amber-400
                        transition-all duration-200">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M6.5 8.5H3V21h3.5V8.5ZM4.75 3C3.65 3 3 3.72 3 4.65S3.65 6.3 4.72 6.3h.03c1.1 0 1.75-.72 1.75-1.65C6.5 3.72 5.83 3 4.75 3ZM21 13.84c0-3.77-2.01-5.52-4.69-5.52-2.16 0-3.12 1.19-3.66 2.03V8.5H9.15V21h3.5v-6.96c0-.37.03-.74.14-1 .29-.74.95-1.51 2.06-1.51 1.45 0 2.03 1.1 2.03 2.7V21H21v-7.16Z"/>
                </svg>
            </button>

            <!-- Telegram -->
            <button type="button"
                    data-share="telegram"
                    aria-label="Share on Telegram"
                    title="Share on Telegram"
                    class="w-9 h-9 flex items-center justify-center rounded-full
                        border border-gray-200 dark:border-gray-700
                        text-gray-500 dark:text-gray-400
                        hover:text-amber-500 dark:hover:text-amber-400
                        hover:border-amber-400 dark:hover:border-amber-400
                        transition-all duration-200">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M21.8 4.6 18.7 19c-.23 1.02-.84 1.27-1.7.79l-4.67-3.44-2.25 2.17c-.25.25-.46.46-.94.46l.34-4.76 8.67-7.83c.38-.34-.08-.53-.59-.19L6.84 12.94 2.23 11.5c-1-.31-1.02-1 .21-1.49L20.46 3c.85-.31 1.59.2 1.34 1.6Z"/>
                </svg>
            </button>

            <!-- X -->
            <button type="button"
                    data-share="x"
                    aria-label="Share on X"
                    title="Share on X"
                    class="w-9 h-9 flex items-center justify-center rounded-full
                        border border-gray-200 dark:border-gray-700
                        text-gray-500 dark:text-gray-400
                        hover:text-amber-500 dark:hover:text-amber-400
                        hover:border-amber-400 dark:hover:border-amber-400
                        transition-all duration-200">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18.9 2H22l-6.77 7.74L23.2 22h-6.24l-4.89-6.39L6.48 22H3.37l7.24-8.28L2.8 2h6.4l4.42 5.84L18.9 2Zm-1.1 17.9h1.73L8.28 4.02H6.42L17.8 19.9Z"/>
                </svg>
            </button>

            <!-- Copy Link -->
            <button type="button"
                    data-share="copy"
                    aria-label="Copy link"
                    title="Copy link"
                    class="w-9 h-9 flex items-center justify-center rounded-full
                        border border-gray-200 dark:border-gray-700
                        text-gray-500 dark:text-gray-400
                        hover:text-amber-500 dark:hover:text-amber-400
                        hover:border-amber-400 dark:hover:border-amber-400
                        transition-all duration-200">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 7h8m-8 4h8m-8 4h5M6 3h9a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V5a2 2 0 012-2Z"/>
                </svg>
            </button>

            <span id="copy-message"
                class="text-xs text-amber-500 opacity-0 transition-opacity duration-300 ml-1">
            </span>

        </div>
        {% endif %}
        
        {% if item.image and item.image != "" and item.image != "placeholder.jpg" and item.image != "README.md" %}
        <div class="mb-8">
            <img src="/content/{{ item.folder }}/{{ item.name }}/images/{{ item.image }}"
            alt="{{ item.title }}" 
            class="w-full max-h-[500px] object-contain rounded-lg bg-white p-4"
            onerror="this.parentElement.style.display='none'">
        </div>
        {% endif %}
    </header>

    {% if item.tabSlug == "blog" %}
    <!-- Table of Contents -->
        <nav id="table-of-contents"
            dir="rtl"
            class="mb-10 p-5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50 text-right">
        <div class="flex items-center gap-2 mb-4">
            <svg class="w-4 h-4 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M4 6h16M4 12h16M4 18h10"></path>
            </svg>
            <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-700 dark:text-gray-200">
                On this page
            </h2>
        </div>

        <ol id="toc-list" class="space-y-2 text-sm"></ol>
    </nav>
    {% endif %}

    <div class="content-area max-w-none">
        {{ item.content | markdown | safe }}
    </div>

    <!-- Back to Top -->
        <button id="back-to-top"
                type="button"
                aria-label="Back to top"
                class="fixed bottom-6 right-6 z-50 hidden items-center justify-center w-10 h-10 rounded-full bg-primary-600 text-white shadow-lg hover:bg-primary-700 transition-all duration-300 opacity-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 15l7-7 7 7">
                </path>
            </svg>
        </button>

        <script>
        document.addEventListener("DOMContentLoaded", () => {
            const button = document.getElementById("back-to-top");

            if (!button) return;

            window.addEventListener("scroll", () => {
                if (window.scrollY > 500) {
                    button.classList.remove("hidden");
                    button.classList.add("flex");

                    requestAnimationFrame(() => {
                        button.classList.remove("opacity-0");
                    });
                } else {
                    button.classList.add("opacity-0");

                    setTimeout(() => {
                        if (window.scrollY <= 500) {
                            button.classList.remove("flex");
                            button.classList.add("hidden");
                        }
                    }, 300);
                }
            });

            button.addEventListener("click", () => {
                window.scrollTo({
                    top: 0,
                    behavior: "smooth"
                });
            });
        });
        </script>     

    {% if item.tabSlug == "blog" %}
    <script>
    document.addEventListener("DOMContentLoaded", () => {
        const progressBar = document.getElementById("reading-progress");

        if (!progressBar) return;

        window.addEventListener("scroll", () => {
            const scrollTop = window.scrollY;
            const documentHeight =
                document.documentElement.scrollHeight - window.innerHeight;

            const progress =
                documentHeight > 0
                    ? (scrollTop / documentHeight) * 100
                    : 0;

            progressBar.style.width = `${progress}%`;
        });
    });
    </script>
    {% endif %}

    <!-- Sticky Article Header -->
    {% if item.tabSlug == "blog" %}
    <script>
    document.addEventListener("DOMContentLoaded", () => {
        const header = document.getElementById("sticky-article-header");
        const percentText = document.getElementById("sticky-reading-percent");

        if (!header || !percentText) return;

        const updateStickyHeader = () => {
            const scrollTop = window.scrollY;
            const documentHeight =
                document.documentElement.scrollHeight - window.innerHeight;

            const progress =
                documentHeight > 0
                    ? Math.round((scrollTop / documentHeight) * 100)
                    : 0;

            percentText.textContent = `${Math.min(progress, 100)}%`;

            if (scrollTop > 350) {
                header.classList.remove("hidden");
            } else {
                header.classList.add("hidden");
            }
        };

        window.addEventListener("scroll", updateStickyHeader, {
            passive: true
        });

        updateStickyHeader();
    });
    </script>
    {% endif %}
    
    {% if item.tabSlug == "blog" %}
        <script>
        document.addEventListener("DOMContentLoaded", () => {
            const url = window.location.href;
            const title = document.title;
            const copyMessage = document.getElementById("copy-message");

            document.querySelectorAll("[data-share]").forEach(button => {
                button.addEventListener("click", async () => {
                    const type = button.dataset.share;

                    if (type === "linkedin") {
                        window.open(
                            `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`,
                            "_blank",
                            "noopener,noreferrer"
                        );
                    }

                    if (type === "telegram") {
                        window.open(
                            `https://t.me/share/url?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`,
                            "_blank",
                            "noopener,noreferrer"
                        );
                    }

                    if (type === "x") {
                        window.open(
                            `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`,
                            "_blank",
                            "noopener,noreferrer"
                        );
                    }

                    if (type === "copy") {
                        try {
                            await navigator.clipboard.writeText(url);

                            copyMessage.textContent = "Copied!";
                            copyMessage.classList.remove("opacity-0");

                            clearTimeout(window.copyMessageTimer);

                            window.copyMessageTimer = setTimeout(() => {
                                copyMessage.classList.add("opacity-0");
                            }, 1500);

                        } catch (error) {
                            copyMessage.textContent = "Copy failed";
                            copyMessage.classList.remove("opacity-0");
                        }
                    }
                });
            });
        });
        </script>
        {% endif %}

    {% if item.tabSlug == "blog" %}
    <script>
    document.addEventListener("DOMContentLoaded", () => {
        const images = document.querySelectorAll(".content-area img");

        images.forEach(image => {
            image.classList.add(
                "cursor-zoom-in",
                "transition-transform",
                "duration-200",
                "hover:scale-[1.01]"
            );
        });
    });
    </script>
    {% endif %}

    {% if item.tabSlug == "blog" %}
    <script>
    document.addEventListener("DOMContentLoaded", () => {
        const images = document.querySelectorAll(".content-area img");

        if (!images.length) return;

        const overlay = document.createElement("div");

        overlay.id = "image-lightbox";
        overlay.className =
            "fixed inset-0 z-[200] hidden items-center justify-center bg-black/80 p-6 cursor-zoom-out";

        overlay.innerHTML = `
            <img
                id="lightbox-image"
                src=""
                alt=""
                class="max-w-full max-h-full object-contain rounded-lg shadow-2xl"
            >
        `;

        document.body.appendChild(overlay);

        const lightboxImage = document.getElementById("lightbox-image");

        images.forEach(image => {
            image.addEventListener("click", () => {
                lightboxImage.src = image.src;
                lightboxImage.alt = image.alt || "";

                overlay.classList.remove("hidden");
                overlay.classList.add("flex");

                document.body.style.overflow = "hidden";
            });
        });

        const closeLightbox = () => {
            overlay.classList.add("hidden");
            overlay.classList.remove("flex");

            document.body.style.overflow = "";
        };

        overlay.addEventListener("click", (event) => {
            if (event.target === overlay) {
                closeLightbox();
            }
        });

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && !overlay.classList.contains("hidden")) {
                closeLightbox();
            }
        });
    });
    </script>
    {% endif %}

    {% if item.tabSlug == "blog" %}
    <div id="sticky-article-header"
        class="fixed top-1 left-0 right-0 z-[90] hidden
                bg-white/90 dark:bg-gray-900/90 backdrop-blur-md
                border-b border-gray-200 dark:border-gray-800
                transition-all duration-300">

        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8
                    h-12 flex items-center justify-between gap-4">

            <span class="text-sm font-medium text-gray-800 dark:text-gray-200
                        truncate">
                {{ item.title }}
            </span>

            <span id="sticky-reading-percent"
                class="text-xs font-medium text-amber-500 whitespace-nowrap">
                0%
            </span>

        </div>
    </div>
    {% endif %}

    <!-- Navigation -->
    <nav class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-700">
        <div class="flex justify-between">
            <a href="/#{{ item.tabSlug }}" 
               class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-600 dark:text-gray-300 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-md hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
                Back to {{ item.tab }}
            </a>
        </div>
    </nav>
</div>

{% if item.tabSlug == "blog" %}
<script>
document.addEventListener("DOMContentLoaded", () => {
    const content = document.querySelector(".content-area");
    const tocList = document.getElementById("toc-list");

    if (!content || !tocList) return;

    const headings = content.querySelectorAll("h2, h3");

    headings.forEach((heading, index) => {
        if (!heading.id) {
            heading.id = `section-${index + 1}`;
        }

        const li = document.createElement("li");
        const link = document.createElement("a");

        link.href = "javascript:void(0)";
        link.onclick = () => {
            heading.scrollIntoView({
                behavior: "smooth",
                block: "start"
            });
        };
        link.textContent = heading.textContent;
        link.className =
            "block py-1 text-amber-600 dark:text-amber-400 hover:text-amber-500 dark:hover:text-amber-300 transition-colors font-medium tracking-wide";

        if (heading.tagName === "H3") {
            link.classList.add("pr-4", "text-sm", "font-normal");
        }

        li.appendChild(link);
        tocList.appendChild(li);
    });

    if (headings.length === 0) {
        document.getElementById("table-of-contents").remove();
    }
});
</script>
{% endif %}