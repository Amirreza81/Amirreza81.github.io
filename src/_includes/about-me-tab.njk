<div class="space-y-8 max-w-3xl mx-auto">
  {% for item in tab.items %}
    {% if item.slug == 'about-me' %}
    <section class="bg-white dark:bg-[#1C2541] rounded-lg shadow-md px-6 py-5">
      <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">
        {{ item.title or "Professional Summary" }}
      </h3>
      {% if item.description %}
      <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
        {{ item.description }}
      </p>
      {% endif %}
    </section>
    {% endif %}
  {% endfor %}

  {% for item in tab.items %}
    {% if item.slug == 'interests-life' %}
    <section class="bg-white dark:bg-[#1C2541] rounded-lg shadow-md px-6 py-5">
      <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
        {{ item.title or "Life & Interests" }}
      </h3>

      {% if item.content and item.content.trim().length > 0 %}
      <div class="content-area prose dark:prose-invert max-w-none mb-6">
        {{ item.content | markdown | safe }}
      </div>
      {% endif %}

      <div class="flex flex-wrap gap-4">
        {% if item.telegramUrl %}
        <a href="{{ item.telegramUrl }}"
           target="_blank"
           rel="noopener noreferrer"
           class="interest-link group">
          <span class="interest-link-icon bg-[#229ED9]/10 text-[#229ED9] group-hover:bg-[#229ED9] group-hover:text-white">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
            </svg>
          </span>
          <span>
            <span class="interest-link-label">{{ item.telegramLabel or "Telegram" }}</span>
            <span class="interest-link-hint">Music channel</span>
          </span>
        </a>
        {% endif %}

        {% if item.imdbUrl %}
        <a href="{{ item.imdbUrl }}"
           target="_blank"
           rel="noopener noreferrer"
           class="interest-link group">
          <span class="interest-link-icon interest-link-icon-imdb p-0 overflow-hidden">
            <img src="/images/imdb.svg" alt="" class="w-full h-full" width="40" height="40">
          </span>
          <span>
            <span class="interest-link-label">{{ item.imdbLabel or "IMDb" }}</span>
            <span class="interest-link-hint">Films & ratings</span>
          </span>
        </a>
        {% endif %}

        {% if item.spotifyUrl %}
        <a href="{{ item.spotifyUrl }}"
           target="_blank"
           rel="noopener noreferrer"
           class="interest-link group">
          <span class="interest-link-icon bg-[#1DB954]/10 text-[#1DB954] group-hover:bg-[#1DB954] group-hover:text-white">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
            </svg>
          </span>
          <span>
            <span class="interest-link-label">{{ item.spotifyLabel or "Spotify" }}</span>
            <span class="interest-link-hint">Playlists & listening</span>
          </span>
        </a>
        {% endif %}
      </div>
    </section>
    {% endif %}
  {% endfor %}
</div>
