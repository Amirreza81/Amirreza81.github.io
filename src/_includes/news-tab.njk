{% if tab.items.length > 0 %}
<div class="space-y-4 max-w-3xl mx-auto">
  {% for item in tab.items %}
  <article class="bg-white dark:bg-[#1C2541] rounded-lg shadow-md px-5 py-4">
    <div class="flex items-start justify-between gap-4">
      <div class="flex-1">
        {% if item.start %}
        <time class="text-xs font-medium uppercase tracking-wide text-primary-600 dark:text-primary-400">
          {{ item.start }}
        </time>
        {% endif %}
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mt-1 mb-2">
          {% if item.link %}
          <a href="{{ item.link }}" target="_blank" rel="noopener noreferrer"
             class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
            {{ item.title }}
          </a>
          {% else %}
          {{ item.title }}
          {% endif %}
        </h3>
        {% if item.description %}
        <p class="text-gray-700 dark:text-gray-300 text-sm leading-relaxed">{{ item.description }}</p>
        {% endif %}
      </div>
    </div>
  </article>
  {% endfor %}
</div>
{% else %}
<div class="text-center py-12 max-w-xl mx-auto">
  <div class="text-gray-500 dark:text-gray-400">
    <svg class="w-12 h-12 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
    </svg>
    <p class="text-lg">No news yet</p>
    <p class="text-sm mt-2 leading-relaxed">
      :)
    </p>
  </div>
</div>
{% endif %}
