{% if tab.items.length > 0 %}

<div class="space-y-4 max-w-3xl mx-auto">
  {% for item in tab.items %}

  {# ---------------------------------------------------------
     CARD COLOR
     Default: normal white/dark card
     Available: gold, blue, green, red, purple
     --------------------------------------------------------- #}

    {% set cardClass = "bg-white dark:bg-[#1C2541] border border-transparent" %}

    {% if item.cardColor == "gold" %}
      {% set cardClass = "bg-amber-200 dark:bg-amber-900/50 border border-amber-300 dark:border-amber-700" %}

    {% elif item.cardColor == "blue" %}
      {% set cardClass = "bg-blue-200 dark:bg-blue-900/50 border border-blue-300 dark:border-blue-700" %}

    {% elif item.cardColor == "green" %}
      {% set cardClass = "bg-emerald-200 dark:bg-emerald-900/50 border border-emerald-300 dark:border-emerald-700" %}

    {% elif item.cardColor == "red" %}
      {% set cardClass = "bg-red-200 dark:bg-red-900/50 border border-red-300 dark:border-red-700" %}

    {% elif item.cardColor == "purple" %}
      {% set cardClass = "bg-purple-200 dark:bg-purple-900/50 border border-purple-300 dark:border-purple-700" %}
    {% endif %}


  {# ---------------------------------------------------------
     BADGE COLOR
     Default: primary blue
     Available: gold, blue, green, red, purple, gray
     --------------------------------------------------------- #}

  {% set badgeClass = "bg-primary-100 dark:bg-primary-900 text-primary-700 dark:text-primary-300" %}

  {% if item.badgeColor == "gold" %}
    {% set badgeClass = "bg-amber-100 dark:bg-amber-900/60 text-amber-800 dark:text-amber-300 border border-amber-300 dark:border-amber-700" %}
  {% elif item.badgeColor == "blue" %}
    {% set badgeClass = "bg-blue-100 dark:bg-blue-900/60 text-blue-800 dark:text-blue-300 border border-blue-300 dark:border-blue-700" %}
  {% elif item.badgeColor == "green" %}
    {% set badgeClass = "bg-emerald-100 dark:bg-emerald-900/60 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-700" %}
  {% elif item.badgeColor == "red" %}
    {% set badgeClass = "bg-red-100 dark:bg-red-900/60 text-red-800 dark:text-red-300 border border-red-300 dark:border-red-700" %}
  {% elif item.badgeColor == "purple" %}
    {% set badgeClass = "bg-purple-100 dark:bg-purple-900/60 text-purple-800 dark:text-purple-300 border border-purple-300 dark:border-purple-700" %}
  {% elif item.badgeColor == "gray" %}
    {% set badgeClass = "bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 border border-gray-300 dark:border-gray-600" %}
  {% endif %}


  {# ---------------------------------------------------------
     CARD
     --------------------------------------------------------- #}

  <article class="{{ cardClass }} rounded-xl shadow-md px-5 py-4 transition-all duration-200 hover:shadow-lg">

    <div class="flex items-start justify-between gap-4">

      <div class="flex-1">

        {% if item.start %}
        <time class="text-xs font-medium uppercase tracking-wide text-primary-600 dark:text-primary-400">
          {{ item.start }}
        </time>
        {% endif %}


        {# -----------------------------------------------------
           TITLE + BADGE
           ----------------------------------------------------- #}

        <div class="flex items-center gap-2 flex-wrap mt-1 mb-2">

          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">

            {% if item.link %}

            <a
              href="{{ item.link }}"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
            >
              {{ item.title }}
            </a>

            {% else %}

            {{ item.title }}

            {% endif %}

          </h3>


          {# ---------------------------------------------------
             BADGE
             Only shown when badge exists
             --------------------------------------------------- #}

          {% if item.badge %}

          <span
            class="{{ badgeClass }} inline-flex items-center rounded-full px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider shadow-sm"
          >
            {{ item.badge }}
          </span>

          {% endif %}

        </div>


        {# -----------------------------------------------------
           DESCRIPTION
           ----------------------------------------------------- #}

        {% if item.description %}
        <p class="text-gray-700 dark:text-gray-300 text-sm leading-relaxed">
          {{ item.description }}
        </p>
        {% endif %}

        {% if item.content %}
        <details class="mt-4 group">
          <summary class="cursor-pointer text-sm font-medium text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300">
            Details
          </summary>

          <div class="mt-3 text-gray-700 dark:text-gray-300 text-sm leading-relaxed prose prose-sm dark:prose-invert [&_strong]:!text-gray-900 dark:[&_strong]:!text-white [&_b]:!text-gray-900 dark:[&_b]:!text-white max-w-none">
            {{ item.content | markdown | safe }}
          </div>
        </details>
        {% endif %}

      </div>

    </div>

  </article>

  {% endfor %}
</div>


{% else %}

<div class="text-center py-12 max-w-xl mx-auto">

  <div class="text-gray-500 dark:text-gray-400">

    <svg
      class="w-12 h-12 mx-auto mb-4"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
      >
      </path>
    </svg>

    <p class="text-lg">
      No news yet
    </p>

    <p class="text-sm mt-2 leading-relaxed">
      :)
    </p>

  </div>

</div>

{% endif %}
