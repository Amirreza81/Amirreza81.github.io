{% if tab.items.length > 0 %}
<div class="space-y-6">
  {% for item in tab.items %}
    {% if loop.index0 < 3 %}
    <div class="portfolio-card blog-card rounded-lg shadow-md">
      <a href="/{{ tab.slug }}/{{ item.slug }}/" class="block no-underline hover:no-underline">
        <div class="px-6 py-5">
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1">
              <h3 class="blog-title text-xl font-semibold mb-2">{{ item.title }}</h3>
              {% if item.description %}
              <p class="text-gray-700 dark:text-gray-300 mb-3">{{ item.description }}</p>
              {% endif %}
              <div class="blog-read-more flex items-center">
                <span class="text-sm font-medium">Read post</span>
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </div>
            </div>
            {% if item.start %}
            <div class="text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap">{{ item.start }}</div>
            {% endif %}
          </div>
        </div>
      </a>
    </div>
    {% endif %}
  {% endfor %}

  {% if tab.items.length > 3 %}
  <div class="text-center pt-2">
    <a href="/{{ tab.slug }}/"
       class="inline-flex items-center gap-2 text-sm font-medium text-primary-600 dark:text-primary-400 hover:underline">
      View all posts ({{ tab.items.length }})
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </a>
  </div>
  {% endif %}
</div>
{% else %}
<div class="text-center py-12 max-w-xl mx-auto">
  <div class="text-gray-500 dark:text-gray-400">
    <svg class="w-12 h-12 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
    </svg>
    <p class="text-lg">No blog posts yet</p>
    <p class="text-sm mt-2 leading-relaxed">
      :)
    </p>
  </div>
</div>
{% endif %}
